<Window x:Class="Notchly.App.Island.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notchly Island"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource IslandFont}" Foreground="White"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- The island is always black, whatever the app theme: local styles keep controls readable. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <SolidColorBrush x:Key="Dim" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="Faint" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#FFFFFFFF" />

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Back" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LyricsToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Back" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#40FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row that acts as a button: transparent until the pointer is over it. -->
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" CornerRadius="6" Background="Transparent" Padding="2,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" CornerRadius="13" Background="#1FFFFFFF" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A menu that belongs to the island: black like it, with a faint edge, whatever the app theme. -->
        <Style x:Key="IslandMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource IslandFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#FF161616" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12"
                                Padding="5" MinWidth="200" Margin="0,6,0,0">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IslandMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Back" CornerRadius="7" Background="Transparent" Padding="8,6,12,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Check" Grid.Column="0" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           VerticalAlignment="Center" Visibility="Hidden" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Dim}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IslandMenuSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#26FFFFFF" Margin="8,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A thin level/timeline slider. -->
        <Style x:Key="IslandSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="16" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <!-- Style="{x:Null}": WPF-UI's own RepeatButton style otherwise hides the played part. -->
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Style="{x:Null}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Style="{x:Null}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Style="{x:Null}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas x:Name="Root">
        <Grid x:Name="Surface" Canvas.Left="0" Canvas.Top="0" Background="{x:Null}">
            <!-- The island itself: black right up to the screen's top edge. -->
            <Path x:Name="Shape" Fill="Black" />
            <!-- Its edge, on a layer of its own: a 2-point stroke clipped to the island, so only its
                 inner point shows (upstream NotchLayout.outlineWidth). Clipping it never clips the fill. -->
            <Path x:Name="Edge" StrokeThickness="2" IsHitTestVisible="False" />
            <Grid x:Name="ContentLayer">

                <!-- Closed strip: wings either side of the simulated camera. -->
                <Grid x:Name="Strip" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftWingColumn" Width="0" />
                        <ColumnDefinition x:Name="CameraColumn" Width="*" />
                        <ColumnDefinition x:Name="RightWingColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="LeftWing" Grid.Column="0" ClipToBounds="True">
                        <Border x:Name="StripArt" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="Collapsed" Margin="0,0,6,0">
                            <Border.Background>
                                <ImageBrush x:Name="StripArtBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="StripIcon" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />
                        <!-- An event's countdown: its calendar's dot and title beside the camera (upstream NotchCalendarStrip). -->
                        <StackPanel x:Name="CalLead" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="6,0,8,0" Visibility="Collapsed">
                            <Ellipse x:Name="CalDot" Width="6" Height="6" Stroke="#80FFFFFF" StrokeThickness="0.5" VerticalAlignment="Center" />
                            <TextBlock x:Name="CalTitle" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- A download: its arrow and name from the wing's outer edge (upstream NotchDownloadStrip). -->
                        <StackPanel x:Name="StripLead" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="10,0,4,0" Visibility="Collapsed">
                            <TextBlock x:Name="StripLeadIcon" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="StripLeadText" FontSize="11" FontWeight="Medium" Margin="6,0,0,0"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Working agents: their marks from the wing's outer end (upstream NotchAgentStrip). -->
                        <StackPanel x:Name="AgentMarks" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                        <!-- A watch: its eye from the wing's outer end (upstream NotchWatchStrip). -->
                        <TextBlock x:Name="WatchEye" FontFamily="{StaticResource IconFont}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   TextTrimming="None" Visibility="Collapsed" />
                        <!-- A level beside the camera: its mark and reading from the wing's outer end
                             (upstream NotchNoticeView.leading). -->
                        <StackPanel x:Name="LevelLead" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="13,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="LevelLeadIcon" FontFamily="{StaticResource IconFont}" FontSize="13" Width="18"
                                       TextAlignment="Center" TextTrimming="None" VerticalAlignment="Center" />
                            <TextBlock x:Name="LevelLeadText" FontSize="11" FontWeight="Medium" Typography.NumeralAlignment="Tabular"
                                       TextTrimming="None" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- A new song: its cover and title from the wing's outer end (upstream NotchNoticeView, .track). -->
                        <StackPanel x:Name="TrackLead" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="12,0,0,0" Visibility="Collapsed">
                            <Border x:Name="TrackLeadArt" Width="18" Height="18" CornerRadius="4" VerticalAlignment="Center">
                                <Border.Background>
                                    <ImageBrush x:Name="TrackLeadArtBrush" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <TextBlock x:Name="TrackLeadTitle" FontSize="11" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- A notification: its app's icon and title from the wing's outer end
                             (upstream NotchNoticeView.leading for a notification). -->
                        <StackPanel x:Name="NotifLead" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Border x:Name="NotifIcon" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock x:Name="NotifTitle" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="RightWing" Grid.Column="2" ClipToBounds="True">
                        <StackPanel x:Name="StripBars" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                        <TextBlock x:Name="StripText" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Margin="8,0,8,0" Visibility="Collapsed" />
                        <!-- The event's clock and when it starts or ends. -->
                        <StackPanel x:Name="CalTrail" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="8,0,6,0" Visibility="Collapsed">
                            <TextBlock x:Name="CalClock" FontSize="13" FontWeight="Medium" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                            <TextBlock x:Name="CalTime" FontSize="11" FontWeight="Medium" Foreground="#8CFFFFFF" Margin="4,0,0,0"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- A download's reading toward the wing's outer edge: a meter and percentage, or the size so far. -->
                        <StackPanel x:Name="StripTrail" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="4,0,10,0" Visibility="Collapsed">
                            <Grid x:Name="StripTrailMeter" Width="36" Height="4" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Border CornerRadius="2" Background="#33FFFFFF" />
                                <Border x:Name="StripTrailFill" CornerRadius="2" Background="White" HorizontalAlignment="Left" Width="0" />
                            </Grid>
                            <TextBlock x:Name="StripTrailText" FontSize="10" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- ...and its message at the far end, on one line or two in a tall strip. -->
                        <TextBlock x:Name="NotifDetail" FontSize="11" Foreground="#D9FFFFFF" HorizontalAlignment="Right" TextAlignment="Right"
                                   VerticalAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="13" Visibility="Collapsed" />
                        <!-- ...and the reading the person chose toward the other end. -->
                        <TextBlock x:Name="AgentReading" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" TextTrimming="None" Visibility="Collapsed" />
                        <!-- ...and what the area reads toward the other end, or the area itself when it has no text. -->
                        <TextBlock x:Name="WatchReading" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        <Border x:Name="WatchThumb" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="True"
                                Visibility="Collapsed">
                            <Image x:Name="WatchThumbImage" Stretch="Uniform" />
                        </Border>
                        <!-- ...and its artist toward the other end. -->
                        <TextBlock x:Name="TrackTrail" FontSize="11" FontWeight="Medium" Foreground="#CCFFFFFF" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Margin="6,0,12,0" Visibility="Collapsed" />
                        <!-- ...and its meter from the camera to the other end (upstream NotchNoticeView.trailing). -->
                        <Grid x:Name="LevelMeter" Height="5" VerticalAlignment="Center" Margin="0,0,13,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="LevelMeterFilled" Width="0*" />
                                <ColumnDefinition x:Name="LevelMeterEmpty" Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" CornerRadius="2.5" Background="#24FFFFFF" />
                            <Border Grid.Column="0" CornerRadius="2.5" Background="#E6FFFFFF" />
                        </Grid>
                    </Grid>
                    <!-- A capsule's level notice: one row from its round end, mark, meter and reading
                         (upstream NotchCapsuleNoticeView.levelRow). -->
                    <StackPanel x:Name="StripRow" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="StripRowIcon" FontFamily="{StaticResource IconFont}" FontSize="12" Width="16"
                                   TextAlignment="Center" TextTrimming="None" VerticalAlignment="Center" />
                        <Grid Width="56" Height="4" Margin="6,0,0,0" VerticalAlignment="Center">
                            <Border CornerRadius="2" Background="#24FFFFFF" />
                            <Border x:Name="StripRowFill" CornerRadius="2" Background="#E6FFFFFF" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <TextBlock x:Name="StripRowText" FontSize="12" FontWeight="Medium" TextAlignment="Right" TextTrimming="None"
                                   Typography.NumeralAlignment="Tabular" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Drag-reveal: the closed island grown into a drop target (upstream NotchView placeholder). -->
                <Grid x:Name="DropPlaceholder" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="18,0,18,14" Height="52">
                    <Rectangle RadiusX="16" RadiusY="16" Stroke="#3DFFFFFF" StrokeThickness="1" StrokeDashArray="5 4" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Drop files here" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Open island: a row of page buttons, then the page. -->
                <Grid x:Name="OpenLayer" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="HeaderRow" Height="36" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel x:Name="Tabs" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ToggleButton x:Name="QueueButton" Style="{StaticResource LyricsToggle}" Content="&#xE8FD;" ToolTip="Up next"
                                          Visibility="Collapsed" Margin="0,0,2,0" />
                            <ToggleButton x:Name="LyricsButton" Style="{StaticResource LyricsToggle}" Content="&#xE8BD;" ToolTip="Lyrics"
                                          Visibility="Collapsed" Margin="0,0,2,0" />
                            <Button x:Name="NotificationsClear" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Clear All"
                                    Visibility="Collapsed" Margin="0,0,2,0" />
                            <!-- The camera mirror's chooser (more than one camera) and Stop camera (upstream NotchCameraChooser
                                 and NotchCameraStopButton in the top row). -->
                            <Button x:Name="CameraMenu" Style="{StaticResource ChipButton}" Padding="10,4" Margin="0,0,6,0"
                                    Visibility="Collapsed" AutomationProperties.Name="Camera">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B8;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock x:Name="CameraMenuName" Text="Camera" FontSize="11" FontWeight="Medium" MaxWidth="140"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                               VerticalAlignment="Center" Margin="6,1,0,0" Foreground="{StaticResource Dim}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CameraStop" Style="{StaticResource ChipButton}" Padding="10,4" Margin="0,0,6,0"
                                    Visibility="Collapsed" Content="Stop camera" FontSize="11" />
                            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Island settings" />
                            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Close" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" x:Name="Pages">

                        <!-- Home (upstream "controls") -->
                        <Grid x:Name="HomePage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" x:Name="HomePlayer">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="10" Background="#1FFFFFFF">
                                    <Grid>
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Dim}" />
                                        <Border CornerRadius="10">
                                            <Border.Background>
                                                <ImageBrush x:Name="HomeArt" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="HomeTitle" FontSize="14" FontWeight="SemiBold" Text="Nothing playing" />
                                    <TextBlock x:Name="HomeArtist" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="HomePrevious" Style="{StaticResource IconButton}" Content="&#xE892;" />
                                    <Button x:Name="HomePlayPause" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="16" Width="34" Height="34" />
                                    <Button x:Name="HomeNext" Style="{StaticResource IconButton}" Content="&#xE893;" />
                                </StackPanel>
                            </Grid>
                            <!-- Volume and brightness share one row, as upstream's levels: the sliders show the level,
                                 so there is no readout. Without a brightness to set, the volume takes the row. -->
                            <Grid Grid.Row="2" x:Name="HomeLevels">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="HomeVolumeHalf" Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Icon buttons carry 7 points of air around their glyph: the speaker's glyph lines up
                                         with the cover and chips above and below it. -->
                                    <Button x:Name="HomeMute" Grid.Column="0" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="Mute"
                                            HorizontalAlignment="Left" Margin="-7,0,0,0" />
                                    <Slider x:Name="HomeVolume" Grid.Column="1" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="100"
                                            VerticalAlignment="Center" Margin="6,0,2,0" ToolTip="Volume" />
                                    <Button x:Name="HomeOutputMenu" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE70D;"
                                            FontSize="9" Width="20" Foreground="{StaticResource Dim}" ToolTip="Choose a speaker" />
                                </Grid>
                                <Grid x:Name="HomeBrightnessHalf" Grid.Column="1" Margin="14,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Slider x:Name="HomeBrightness" Grid.Column="1" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="100"
                                            VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Brightness" />
                                </Grid>
                            </Grid>
                            <!-- Each chip keeps 6 points below it for a wrapped row; the last row gives it back. -->
                            <WrapPanel Grid.Row="4" x:Name="HomeChips" Margin="0,0,0,-6">
                                <Button x:Name="HomeBatteryChip" Style="{StaticResource ChipButton}" Padding="10,5" ToolTip="Battery details">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="HomeBatteryIcon" Text="&#xE83F;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HomeBattery" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="HomeOutputChip" Style="{StaticResource ChipButton}" Padding="10,5" ToolTip="Choose a speaker">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HomeOutput" FontSize="12" Margin="6,0,0,0" MaxWidth="220" VerticalAlignment="Center" />
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" Margin="6,1,0,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource Dim}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="HomeAwakeChip" Style="{StaticResource ChipButton}" Visibility="Collapsed" ToolTip="Keep this PC awake">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="HomeAwakeIcon" Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HomeAwakeText" Text="Awake" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="HomeTimerChip" Style="{StaticResource ChipButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HomeTimerText" Text="Timer" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <!-- The battery chip's details: what Windows reports, refreshed while it is open. -->
                            <Border Grid.Row="5" x:Name="HomeBatteryPanel" Visibility="Collapsed" Background="#14FFFFFF"
                                    CornerRadius="12" Padding="12,8" Margin="0,14,0,0">
                                <Grid x:Name="HomeBatteryRows" />
                            </Border>
                        </Grid>

                        <!-- Music -->
                        <Grid x:Name="MusicPage" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        <Grid x:Name="MusicPlayer" Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="88" Height="88" CornerRadius="14" Background="#1FFFFFFF">
                                    <Border CornerRadius="14">
                                        <Border.Background>
                                            <ImageBrush x:Name="MusicArt" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <Button x:Name="MusicStar" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE734;" FontSize="16"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Star" Panel.ZIndex="1" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,34,0">
                                    <TextBlock x:Name="MusicTitle" FontSize="17" FontWeight="SemiBold" Text="Nothing playing" />
                                    <TextBlock x:Name="MusicArtist" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,3,0,0" />
                                    <TextBlock x:Name="MusicSource" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                            <Slider x:Name="MusicTimeline" Grid.Row="2" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="1" />
                            <Grid Grid.Row="3" Margin="0,2,0,0">
                                <TextBlock x:Name="MusicElapsed" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="MusicRemaining" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button x:Name="MusicShuffle" Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="16" Width="40" Height="40" ToolTip="Shuffle" Margin="0,0,6,0" />
                                <Button x:Name="MusicPrevious" Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="18" Width="44" Height="44" />
                                <Button x:Name="MusicPlayPause" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="24" Width="56" Height="56" Margin="12,0" />
                                <Button x:Name="MusicNext" Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="18" Width="44" Height="44" />
                                <Button x:Name="MusicRepeat" Style="{StaticResource IconButton}" Content="&#xE8EE;" FontSize="16" Width="40" Height="40" ToolTip="Loop" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Nothing playing: the user's Spotify playlists, to start one (a Windows addition). -->
                        <Grid x:Name="MusicIdle" Grid.Row="0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="MusicIdleStatus" FontSize="12" Foreground="{StaticResource Dim}" Margin="2,0,0,8" TextWrapping="Wrap"
                                       TextTrimming="None" Text="Nothing playing" />
                            <ScrollViewer x:Name="MusicIdleScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False" CanContentScroll="False">
                                <StackPanel x:Name="MusicIdleList" />
                            </ScrollViewer>
                        </Grid>

                        <!-- Up next (Spotify): the songs queued after this one, sharing the lyrics' slot. -->
                        <Grid x:Name="QueuePanel" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Up next" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Dim}" Margin="2,0,0,6" />
                                <StackPanel x:Name="QueueRows" />
                                <TextBlock x:Name="QueueMessage" FontSize="12" Foreground="{StaticResource Dim}" Margin="2,6,0,0" TextWrapping="Wrap"
                                           TextTrimming="None" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <!-- Lyrics (upstream NotchLyricsView): synced verses, or a message with its next step. -->
                        <Grid x:Name="LyricsPanel" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer x:Name="LyricsScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False" CanContentScroll="False">
                                <StackPanel x:Name="LyricsLines" Margin="0,0,0,40" />
                            </ScrollViewer>
                            <StackPanel x:Name="LyricsMessage" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="LyricsMessageIcon" FontFamily="{StaticResource IconFont}" FontSize="20"
                                           HorizontalAlignment="Center" Foreground="{StaticResource Dim}" Margin="0,0,0,8" />
                                <TextBlock x:Name="LyricsMessageText" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                           TextTrimming="None" MaxWidth="420" Foreground="{StaticResource Dim}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <Button x:Name="LyricsPrimary" Style="{StaticResource ChipButton}" />
                                    <Button x:Name="LyricsImport" Style="{StaticResource ChipButton}" Content="Import lyrics…" />
                                </StackPanel>
                            </StackPanel>
                            <Grid x:Name="LyricsTiming" Grid.Row="1" Margin="0,4,0,0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="LyricsImportIcon" Style="{StaticResource IconButton}" Content="&#xE8E5;" FontSize="12" ToolTip="Import lyrics…" />
                                    <TextBlock Text="Timing" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="LyricsEarlier" Style="{StaticResource IconButton}" Content="&#xE738;" FontSize="11" ToolTip="Earlier" />
                                    <Button x:Name="LyricsOffset" Style="{StaticResource ChipButton}" Margin="2,0" Padding="8,3" FontSize="11"
                                            MinWidth="52" Content="+0.00" ToolTip="Reset" />
                                    <Button x:Name="LyricsLater" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="11" ToolTip="Later" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        </Grid>

                        <!-- Files (upstream NotchFilesView): the shelf's tiles, flowing sideways. -->
                        <Grid x:Name="FilesPage" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock x:Name="FilesHint" FontSize="10" TextWrapping="Wrap" TextTrimming="None" MaxWidth="250"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource Dim}"
                                           Text="Click to select. Drag out to use or right-click for more actions." />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="FilesZip" Style="{StaticResource ChipButton}" Margin="0,0,6,0" Content="Create ZIP"
                                            ToolTip="Each selected item is saved as a separate ZIP. Originals stay unchanged." />
                                    <Button x:Name="FilesShare" Style="{StaticResource IconButton}" Content="&#xE72D;" ToolTip="Share" Margin="0,0,4,0" />
                                    <Button x:Name="FilesClear" Style="{StaticResource ChipButton}" Margin="0" Content="Clear all" />
                                </StackPanel>
                            </Grid>
                            <ScrollViewer x:Name="FilesScroller" Grid.Row="2" HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled" Focusable="False">
                                <WrapPanel x:Name="FilesTiles" Orientation="Vertical" Margin="4" />
                            </ScrollViewer>
                            <Grid x:Name="FilesEmpty" Grid.Row="2" Visibility="Collapsed">
                                <Rectangle RadiusX="20" RadiusY="20" Stroke="#2EFFFFFF" StrokeThickness="0.75" StrokeDashArray="4 5" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="22" HorizontalAlignment="Center"
                                               Foreground="{StaticResource Dim}" />
                                    <TextBlock Text="Drop files here" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center"
                                               Foreground="{StaticResource Dim}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Clipboard history (upstream NotchClipboardView): built in code by ClipboardPage. -->
                        <Grid x:Name="ClipboardPage" Visibility="Collapsed" />

                        <!-- Downloads (upstream NotchDownloadsView): transfers arriving and the folder's newest files. -->
                        <Grid x:Name="DownloadsPage" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button x:Name="DownloadsFolder" Grid.Row="0" Style="{StaticResource ChipButton}" Margin="0"
                                    HorizontalAlignment="Left" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock x:Name="DownloadsFolderName" Text="Downloads" FontSize="11" FontWeight="Medium"
                                               MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                               VerticalAlignment="Center" Margin="6,1,0,0" Foreground="{StaticResource Dim}" />
                                </StackPanel>
                            </Button>
                            <ScrollViewer x:Name="DownloadsScroller" Grid.Row="2" VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel x:Name="DownloadsList" />
                            </ScrollViewer>
                            <StackPanel x:Name="DownloadsEmpty" Grid.Row="2" Visibility="Collapsed" MaxWidth="300"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="DownloadsEmptyGlyph" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                           HorizontalAlignment="Center" Foreground="{StaticResource Dim}" />
                                <TextBlock x:Name="DownloadsEmptyText" Text="No files in this folder" FontSize="12" Margin="0,8,0,0"
                                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource Dim}" />
                                <Button x:Name="DownloadsChoose" Style="{StaticResource ChipButton}" Content="Choose Folder…"
                                        HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <!-- Calendar (upstream NotchCalendarView): built in code by CalendarPage. -->
                        <Grid x:Name="CalendarPage" Visibility="Collapsed" />

                        <!-- AI agents (upstream NotchAgentsView): built in code by AgentsPage. -->
                        <Grid x:Name="AgentsPage" Visibility="Collapsed" />

                        <!-- Notifications (upstream NotchNotificationsView): built in code by NotificationsPage. -->
                        <Grid x:Name="NotificationsPage" Visibility="Collapsed" />

                        <!-- Camera mirror (upstream NotchCameraView): built in code by CameraPage. -->
                        <Grid x:Name="CameraPage" Visibility="Collapsed" />

                        <!-- Watch (upstream NotchWatchView): built in code by WatchPage. -->
                        <Grid x:Name="WatchPage" Visibility="Collapsed" />

                        <!-- Volume mixer (upstream NotchMixerView): built in code by MixerPage. -->
                        <Grid x:Name="MixerPage" Visibility="Collapsed" />

                        <!-- System monitor (upstream NotchSystemView): built in code by SystemPage. -->
                        <Grid x:Name="SystemPage" Visibility="Collapsed" />

                        <!-- Timer, Pomodoro and stopwatch -->
                        <Grid x:Name="TimerPage" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <RadioButton x:Name="ModeTimer" GroupName="TimerMode" Style="{StaticResource TabButton}" Width="86"
                                             FontFamily="{StaticResource IslandFont}" FontSize="12" Content="Timer" />
                                <RadioButton x:Name="ModePomodoro" GroupName="TimerMode" Style="{StaticResource TabButton}" Width="86"
                                             FontFamily="{StaticResource IslandFont}" FontSize="12" Content="Pomodoro" />
                                <RadioButton x:Name="ModeStopwatch" GroupName="TimerMode" Style="{StaticResource TabButton}" Width="86"
                                             FontFamily="{StaticResource IslandFont}" FontSize="12" Content="Stopwatch" />
                            </StackPanel>
                            <TextBlock x:Name="TimerClock" Grid.Row="2" FontSize="48" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Text="15:00" FontFamily="Segoe UI Variable Display, Segoe UI" />
                            <TextBlock x:Name="TimerPhase" Grid.Row="3" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource Dim}" />
                            <WrapPanel x:Name="TimerPresets" Grid.Row="5" HorizontalAlignment="Center" />
                            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Button x:Name="TimerPrimary" Style="{StaticResource ChipButton}" MinWidth="96" Content="Start" />
                                <Button x:Name="TimerNext" Style="{StaticResource ChipButton}" MinWidth="96" Content="Next phase" Visibility="Collapsed" />
                                <Button x:Name="TimerReset" Style="{StaticResource ChipButton}" MinWidth="96" Content="Reset" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Canvas>
</Window>
