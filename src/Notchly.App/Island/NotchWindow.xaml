<Window x:Class="Notchly.App.Island.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notchly Island"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource IslandFont}" Foreground="White"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- The island is always black, whatever the app theme: local styles keep controls readable. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <SolidColorBrush x:Key="Dim" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="Faint" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#FFFFFFFF" />

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Back" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LyricsToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Back" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#40FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row that acts as a button: transparent until the pointer is over it. -->
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" CornerRadius="6" Background="Transparent" Padding="2,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" CornerRadius="13" Background="#1FFFFFFF" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A thin level/timeline slider. -->
        <Style x:Key="IslandSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="16" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas x:Name="Root">
        <Grid x:Name="Surface" Canvas.Left="0" Canvas.Top="0" Background="{x:Null}">
            <Path x:Name="Shape" Fill="Black" />
            <Grid x:Name="ContentLayer">

                <!-- Closed strip: wings either side of the simulated camera. -->
                <Grid x:Name="Strip" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftWingColumn" Width="0" />
                        <ColumnDefinition x:Name="CameraColumn" Width="*" />
                        <ColumnDefinition x:Name="RightWingColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="LeftWing" Grid.Column="0" ClipToBounds="True">
                        <Border x:Name="StripArt" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="Collapsed" Margin="0,0,6,0">
                            <Border.Background>
                                <ImageBrush x:Name="StripArtBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="StripIcon" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />
                        <!-- A download: its arrow and name from the wing's outer edge (upstream NotchDownloadStrip). -->
                        <StackPanel x:Name="StripLead" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="10,0,4,0" Visibility="Collapsed">
                            <TextBlock x:Name="StripLeadIcon" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="StripLeadText" FontSize="11" FontWeight="Medium" Margin="6,0,0,0"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="RightWing" Grid.Column="2" ClipToBounds="True">
                        <StackPanel x:Name="StripBars" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                        <TextBlock x:Name="StripText" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Margin="8,0,8,0" Visibility="Collapsed" />
                        <Grid x:Name="StripLevel" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                              Width="56" Height="4" Visibility="Collapsed">
                            <Border CornerRadius="2" Background="#33FFFFFF" />
                            <Border x:Name="StripLevelFill" CornerRadius="2" Background="White" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <!-- A download's reading toward the wing's outer edge: a meter and percentage, or the size so far. -->
                        <StackPanel x:Name="StripTrail" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="4,0,10,0" Visibility="Collapsed">
                            <Grid x:Name="StripTrailMeter" Width="36" Height="4" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Border CornerRadius="2" Background="#33FFFFFF" />
                                <Border x:Name="StripTrailFill" CornerRadius="2" Background="White" HorizontalAlignment="Left" Width="0" />
                            </Grid>
                            <TextBlock x:Name="StripTrailText" FontSize="10" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Drag-reveal: the closed island grown into a drop target (upstream NotchView placeholder). -->
                <Grid x:Name="DropPlaceholder" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="18,0,18,14" Height="52">
                    <Rectangle RadiusX="16" RadiusY="16" Stroke="#3DFFFFFF" StrokeThickness="1" StrokeDashArray="5 4" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Drop files here" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Open island: a row of page buttons, then the page. -->
                <Grid x:Name="OpenLayer" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="HeaderRow" Height="36" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel x:Name="Tabs" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ToggleButton x:Name="LyricsButton" Style="{StaticResource LyricsToggle}" Content="&#xE8BD;" ToolTip="Lyrics"
                                          Visibility="Collapsed" Margin="0,0,2,0" />
                            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Island settings" />
                            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Close" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" x:Name="Pages">

                        <!-- Home (upstream "controls") -->
                        <Grid x:Name="HomePage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" x:Name="HomePlayer">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="10" Background="#1FFFFFFF">
                                    <Grid>
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Dim}" />
                                        <Border CornerRadius="10">
                                            <Border.Background>
                                                <ImageBrush x:Name="HomeArt" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="HomeTitle" FontSize="14" FontWeight="SemiBold" Text="Nothing playing" />
                                    <TextBlock x:Name="HomeArtist" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="HomePrevious" Style="{StaticResource IconButton}" Content="&#xE892;" />
                                    <Button x:Name="HomePlayPause" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="16" Width="34" Height="34" />
                                    <Button x:Name="HomeNext" Style="{StaticResource IconButton}" Content="&#xE893;" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="HomeMute" Grid.Column="0" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="Mute" />
                                <Slider x:Name="HomeVolume" Grid.Column="1" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="100"
                                        VerticalAlignment="Center" Margin="6,0" />
                                <TextBlock x:Name="HomeVolumeText" Grid.Column="2" FontSize="12" TextAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{StaticResource Dim}" />
                            </Grid>
                            <WrapPanel Grid.Row="4" x:Name="HomeChips">
                                <Border Background="#1FFFFFFF" CornerRadius="13" Padding="10,5" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="HomeBatteryIcon" Text="&#xE83F;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HomeBattery" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#1FFFFFFF" CornerRadius="13" Padding="10,5" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HomeOutput" FontSize="12" Margin="6,0,0,0" MaxWidth="220" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="HomeTimerChip" Style="{StaticResource ChipButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HomeTimerText" Text="Timer" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <!-- Music -->
                        <Grid x:Name="MusicPage" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        <Grid x:Name="MusicPlayer" Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="88" Height="88" CornerRadius="14" Background="#1FFFFFFF">
                                    <Border CornerRadius="14">
                                        <Border.Background>
                                            <ImageBrush x:Name="MusicArt" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="MusicTitle" FontSize="17" FontWeight="SemiBold" Text="Nothing playing" />
                                    <TextBlock x:Name="MusicArtist" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,3,0,0" />
                                    <TextBlock x:Name="MusicSource" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                            <Slider x:Name="MusicTimeline" Grid.Row="2" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="1" />
                            <Grid Grid.Row="3" Margin="0,2,0,0">
                                <TextBlock x:Name="MusicElapsed" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="MusicRemaining" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="MusicPrevious" Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="18" Width="44" Height="44" />
                                <Button x:Name="MusicPlayPause" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="24" Width="56" Height="56" Margin="12,0" />
                                <Button x:Name="MusicNext" Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="18" Width="44" Height="44" />
                            </StackPanel>
                        </Grid>

                        <!-- Lyrics (upstream NotchLyricsView): synced verses, or a message with its next step. -->
                        <Grid x:Name="LyricsPanel" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer x:Name="LyricsScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False" CanContentScroll="False">
                                <StackPanel x:Name="LyricsLines" Margin="0,0,0,40" />
                            </ScrollViewer>
                            <StackPanel x:Name="LyricsMessage" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="LyricsMessageIcon" FontFamily="{StaticResource IconFont}" FontSize="20"
                                           HorizontalAlignment="Center" Foreground="{StaticResource Dim}" Margin="0,0,0,8" />
                                <TextBlock x:Name="LyricsMessageText" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                           TextTrimming="None" MaxWidth="420" Foreground="{StaticResource Dim}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <Button x:Name="LyricsPrimary" Style="{StaticResource ChipButton}" />
                                    <Button x:Name="LyricsImport" Style="{StaticResource ChipButton}" Content="Import lyrics…" />
                                </StackPanel>
                            </StackPanel>
                            <Grid x:Name="LyricsTiming" Grid.Row="1" Margin="0,4,0,0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="LyricsImportIcon" Style="{StaticResource IconButton}" Content="&#xE8E5;" FontSize="12" ToolTip="Import lyrics…" />
                                    <TextBlock Text="Timing" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="LyricsEarlier" Style="{StaticResource IconButton}" Content="&#xE738;" FontSize="11" ToolTip="Earlier" />
                                    <Button x:Name="LyricsOffset" Style="{StaticResource ChipButton}" Margin="2,0" Padding="8,3" FontSize="11"
                                            MinWidth="52" Content="+0.00" ToolTip="Reset" />
                                    <Button x:Name="LyricsLater" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="11" ToolTip="Later" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        </Grid>

                        <!-- Files (upstream NotchFilesView): the shelf's tiles, flowing sideways. -->
                        <Grid x:Name="FilesPage" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock x:Name="FilesHint" FontSize="10" TextWrapping="Wrap" TextTrimming="None" MaxWidth="250"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource Dim}"
                                           Text="Click to select. Drag out to use or right-click for more actions." />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="FilesZip" Style="{StaticResource ChipButton}" Margin="0,0,6,0" Content="Create ZIP"
                                            ToolTip="Each selected item is saved as a separate ZIP. Originals stay unchanged." />
                                    <Button x:Name="FilesShare" Style="{StaticResource IconButton}" Content="&#xE72D;" ToolTip="Share" Margin="0,0,4,0" />
                                    <Button x:Name="FilesClear" Style="{StaticResource ChipButton}" Margin="0" Content="Clear all" />
                                </StackPanel>
                            </Grid>
                            <ScrollViewer x:Name="FilesScroller" Grid.Row="2" HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled" Focusable="False">
                                <WrapPanel x:Name="FilesTiles" Orientation="Vertical" Margin="4" />
                            </ScrollViewer>
                            <Grid x:Name="FilesEmpty" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
                                <Rectangle RadiusX="20" RadiusY="20" Stroke="#2EFFFFFF" StrokeThickness="0.75" StrokeDashArray="4 5" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="22" HorizontalAlignment="Center"
                                               Foreground="{StaticResource Dim}" />
                                    <TextBlock Text="Drop files here" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center"
                                               Foreground="{StaticResource Dim}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Downloads (upstream NotchDownloadsView): transfers arriving and the folder's newest files. -->
                        <Grid x:Name="DownloadsPage" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button x:Name="DownloadsFolder" Grid.Row="0" Style="{StaticResource ChipButton}" Margin="0"
                                    HorizontalAlignment="Left" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock x:Name="DownloadsFolderName" Text="Downloads" FontSize="11" FontWeight="Medium"
                                               MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                               VerticalAlignment="Center" Margin="6,1,0,0" Foreground="{StaticResource Dim}" />
                                </StackPanel>
                            </Button>
                            <ScrollViewer x:Name="DownloadsScroller" Grid.Row="2" VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel x:Name="DownloadsList" />
                            </ScrollViewer>
                            <StackPanel x:Name="DownloadsEmpty" Grid.Row="2" Visibility="Collapsed" MaxWidth="300"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="DownloadsEmptyGlyph" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                           HorizontalAlignment="Center" Foreground="{StaticResource Dim}" />
                                <TextBlock x:Name="DownloadsEmptyText" Text="No files in this folder" FontSize="12" Margin="0,8,0,0"
                                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource Dim}" />
                                <Button x:Name="DownloadsChoose" Style="{StaticResource ChipButton}" Content="Choose Folder…"
                                        HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <!-- Timer, Pomodoro and stopwatch -->
                        <Grid x:Name="TimerPage" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <RadioButton x:Name="ModeTimer" GroupName="TimerMode" Style="{StaticResource TabButton}" Width="86"
                                             FontFamily="{StaticResource IslandFont}" FontSize="12" Content="Timer" />
                                <RadioButton x:Name="ModePomodoro" GroupName="TimerMode" Style="{StaticResource TabButton}" Width="86"
                                             FontFamily="{StaticResource IslandFont}" FontSize="12" Content="Pomodoro" />
                                <RadioButton x:Name="ModeStopwatch" GroupName="TimerMode" Style="{StaticResource TabButton}" Width="86"
                                             FontFamily="{StaticResource IslandFont}" FontSize="12" Content="Stopwatch" />
                            </StackPanel>
                            <TextBlock x:Name="TimerClock" Grid.Row="2" FontSize="48" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Text="15:00" FontFamily="Segoe UI Variable Display, Segoe UI" />
                            <TextBlock x:Name="TimerPhase" Grid.Row="3" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource Dim}" />
                            <WrapPanel x:Name="TimerPresets" Grid.Row="5" HorizontalAlignment="Center" />
                            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Button x:Name="TimerPrimary" Style="{StaticResource ChipButton}" MinWidth="96" Content="Start" />
                                <Button x:Name="TimerNext" Style="{StaticResource ChipButton}" MinWidth="96" Content="Next phase" Visibility="Collapsed" />
                                <Button x:Name="TimerReset" Style="{StaticResource ChipButton}" MinWidth="96" Content="Reset" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Canvas>
</Window>
