<ui:FluentWindow x:Class="Notchly.App.Shell.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Notchly Settings"
                 Width="980" Height="720" MinWidth="760" MinHeight="520"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Notchly Settings" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ui:TextBox x:Name="SearchBox" Grid.Row="0" Margin="12,4,8,4" PlaceholderText="Search settings"
                            ClearButtonEnabled="True" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"
                            AutomationProperties.Name="Search settings" />
                <ListBox x:Name="Navigation" Grid.Row="1" Margin="12,4,8,12" BorderThickness="0"
                         Background="Transparent" SelectionChanged="OnNavigationChanged" PreviewMouseLeftButtonUp="OnNavigationClicked">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,6">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                <ContentControl x:Name="PageHost" Margin="16,4,24,24" MaxWidth="820" HorizontalAlignment="Stretch" />
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
