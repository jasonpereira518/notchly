<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure logic only: no Windows APIs, so everything here is unit-testable. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Notchly.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Notchly.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="5.2.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The AI agents' price list that ships with the app (upstream Resources/agent-prices.json). -->
    <EmbeddedResource Include="Agents\agent-prices.json" LogicalName="Notchly.Core.Agents.agent-prices.json" />
    <!-- The command bar's emoji and their Unicode names, generated by tools/EmojiGen. -->
    <EmbeddedResource Include="CommandBar\Emoji.tsv" LogicalName="Notchly.Core.CommandBar.Emoji.tsv" />
  </ItemGroup>

</Project>
